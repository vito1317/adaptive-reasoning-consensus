# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# venv
.venv/
venv/
env/

# caches / os
.DS_Store
.pytest_cache/
.ipynb_checkpoints/

# large / regenerable raw run dumps (keep small summary JSON + figures)
results/raw/
*.log

# secrets — never commit API keys
.env
*.key

# stale smoke-test artifacts
results/*_quick.json
results/*_run.log

# Word lock files
~$*
.DS_Store

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg

# Third-party PDFs of cited work. Publisher and arXiv copies, so redistributing
# them from a public repository is both bloat (42 MB) and a licensing question
# nobody needs. paper/fetch_references.py downloads them on demand.
paper/refs_pdf/

# Release archives and the per-row upload set, all emitted by
# paper/build_bundles.py from tracked inputs.
paper/*.zip
paper/jmlr_upload/
paper/tmlr_upload/

# Review-pipeline context dumps: copies of the paper's own text, regenerable
# and carrying no information the manuscript does not. The reports themselves
# stay tracked.
paper/review_results/**/artifacts/meta/

# Submission-private material, kept on the author's disk and out of a public
# repository. The JMLR cover letter names five suggested reviewers: publishing
# it would show a reviewer who was put forward, and would post those five
# people's names without their agreement. jmlr_submission/ is the 2 August
# upload set, kept as the record of what manuscript 26-2518 actually received;
# build_bundles.py emits jmlr_upload/ instead, one file per form row.
paper/jmlr_cover_letter.tex
paper/jmlr_cover_letter.pdf
paper/jmlr_submission/
